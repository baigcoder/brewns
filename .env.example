# Copy to .env.local and fill in. Restart `bun run dev` after changing.

# Form-to-email endpoint that receives every order (e.g. a Formspree form:
# https://formspree.io → New form → set the email to the café's inbox → copy
# the endpoint URL, which looks like https://formspree.io/f/xxxxxxx).
NEXT_PUBLIC_ORDER_ENDPOINT=

# Shown on "email the café" links.
NEXT_PUBLIC_CAFE_EMAIL=orders@brewns.coffee

# The site's public address, for canonical links, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://brewns.coffee

# AI voice call. Keep every key server-side; never prefix with NEXT_PUBLIC_.
# Gemini is an optional conversational fallback (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Groq Whisper transcribes caller audio on desktop and mobile (https://console.groq.com/keys).
GROQ_API_KEY=
# Optional preferred model for the Groq conversational agent (default: openai/gpt-oss-120b).
GROQ_MODEL=
# ElevenLabs gives it a natural voice (https://elevenlabs.io → Profile → API key).
ELEVENLABS_API_KEY=
# Optional voice-friendly TTS backup (also used for the conversational AI fallback).
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Shared Redis is required for reliable rate limits, bookings and call logs
# when Vercel serves requests from multiple instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional real booking confirmation delivery; without these, confirmations are recorded locally only.
# The same email service sends order updates, password-reset links and the owner's evening summary.
RESEND_API_KEY=
BREVO_API_KEY=
# Who emails come from, e.g. brewns <hello@your-domain.com>. Needs a domain verified with Resend; until then Resend only delivers to your own account email.
EMAIL_FROM=
# Where customers' replies go.
EMAIL_REPLY_TO=

# Sign-in and setup (required in production).
# Secret for session cookies and sealed two-step secrets: 32+ random characters. Changing it signs everyone out.
SESSION_SECRET=
# The code you type once to create the owner account at /owner/signup. Without it, production refuses owner signup.
OWNER_SETUP_CODE=
# Lets the scheduled daily job (cancel unpaid pay-first orders, email the owner a summary) run. Vercel sends it automatically.
CRON_SECRET=
# Optional automatic WhatsApp delivery; without these, the caller gets a ready-to-share WhatsApp link.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
